DATABASE_URL=postgresql://nhs:nhs@localhost:5432/nhs?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=doi-chuoi-bi-mat-nay
PORT=3000
# Giây chờ ACK từ KDS trước khi gửi lại; số lần gửi lại tối đa
KDS_ACK_TIMEOUT_MS=3000
KDS_MAX_RETRY=3
# Giờ kết thúc ngày kinh doanh (04:00 sáng hôm sau)
BUSINESS_DAY_CUTOFF_HOUR=4
# Hóa đơn điện tử: nhà cung cấp (mock khi dev), tự phát hành sau thanh toán, cảnh báo tồn đọng (ms)
EINVOICE_PROVIDER=mock
EINVOICE_AUTO=true
EINVOICE_BACKLOG_ALERT_MS=1800000
# In phiếu qua print agent: fallback = chỉ in phiếu bếp khi KDS không nhận (mặc định) | always | off
PRINT_KITCHEN_TICKETS=fallback
SHOP_NAME=NHÀ HÀNG SEN
SHOP_ADDRESS=
# Cảnh báo sự cố (watchdog mỗi phút): Telegram hoặc webhook bất kỳ (Zalo OA, Slack…)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
# Token để Prometheus đọc /metrics (để trống khi dev)
METRICS_TOKEN=
# mBot v1 demo: API nói chuyện với robot bridge qua MQTT (mosquitto trong infra)
MQTT_URL=mqtt://localhost:1883
