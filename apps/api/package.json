{
  "name": "@nhs/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest --runInBand",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node -P tsconfig.test.json prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.test.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.0",
    "@nhs/pricing": "workspace:*",
    "@nhs/types": "workspace:*",
    "@prisma/client": "~6.19.0",
    "bullmq": "^5.56.0",
    "exceljs": "^4.4.0",
    "playwright-core": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0",
    "@nhs/einvoice-adapters": "workspace:*",
    "@nhs/robot-adapters": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "prisma": "~6.19.0",
    "socket.io-client": "^4.8.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "@nhs/robot-bridge": "workspace:*"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.e2e-spec.ts"
    ],
    "testTimeout": 60000,
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
